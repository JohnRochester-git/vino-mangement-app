# Copy to .env and fill in real values. Never commit .env.
# Every setting the backend reads is listed here. Blank means "use the default".

# "production" or "development". Only used for labelling today.
FLASK_ENV=development

# Which database to use: "sqlite" (local file) or "d1" (Cloudflare D1 through
# the Worker's bridge). Default: sqlite.
DB_BACKEND=sqlite

# Path of the local SQLite file (DB_BACKEND=sqlite). Default: backend/vino.db.
# docker-compose.yml sets this to /data/vino.db, inside a named volume.
SQLITE_PATH=

# Base URL of the D1 bridge (DB_BACKEND=d1), e.g. http://d1.internal
D1_BRIDGE_URL=
# Seconds to wait for the D1 bridge before giving up. Default: 10.
D1_TIMEOUT=

# Apply pending migrations at startup. Local SQLite only; never happens with
# DB_BACKEND=d1. Default: true.
AUTO_MIGRATE=true

# Comma-separated frontend origins allowed to call the API from another port
# during local development. Leave empty in production (same origin).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Mark the session cookie Secure (HTTPS only). Set true in production.
COOKIE_SECURE=false

# How many days a login lasts. Default: 14.
SESSION_DAYS=14

# Outside barcode lookup: "none" (catalog only) or "openfoodfacts".
BARCODE_PROVIDER=none
# Not needed for openfoodfacts. Reserved for a provider that needs a key.
BARCODE_API_KEY=
# Contact email sent in the User-Agent header, required by Open Food Facts'
# terms when BARCODE_PROVIDER=openfoodfacts. Use a team address.
BARCODE_CONTACT=

# Demo data (python -m vino.seed_demo). Local only.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

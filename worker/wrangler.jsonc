{
	"$schema": "node_modules/wrangler/config-schema.json",
    "name": "vino",
    "main": "src/index.js",
    "compatibility_date": "2026-11-09",
    "observability": { "enabled": true },

    "assets": { "directory": "../frontend", "binding": "ASSETS" },

    "containers": [
        { "class_name": "Backend", "image": "../backend/Dockerfile", "max_instances": 3}
    ],

    "durable_objects": {
        "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
    },

    "exports": {
        "Backend": { "type": "durable-object", "storage": "sqlite" }
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "vino-db",
            "database_id": "06bf3b5f-526d-496a-a812-c28cca7f55a3",
            "migrations_dir": "../backend/migrations",
        }
    ],

    "env": { 
        "preview": {
            "d1_databases": [
                { 
                    "binding": "DB",    
                    "database_name": "vino-db-test", 
                    "database_id": "953ff089-31d0-4ac5-9f6e-e799b7dbd392",
                    "migrations_dir": "../backend/migrations"
                }
            ]
        }
    }
}